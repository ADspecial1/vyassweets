NODE_ENV=production
PORT=5000
MONGO_URI=mongodb+srv://USER:PASS@cluster0.higyn26.mongodb.net/sweets-app?retryWrites=true&w=majority
JWT_SECRET=<same 64-char hex you already generated>
JWT_EXPIRES_IN=7d
# Leading dot so the cookie is valid on both the apex and www hosts
COOKIE_DOMAIN=.vyassweets.com
# Comma-separated whitelist. MUST include every origin the site is served from
# (apex AND www) or POST requests fail CORS. No trailing slashes.
CLIENT_ORIGIN=https://vyassweets.com,https://www.vyassweets.com
RAZORPAY_KEY_ID=rzp_test_PLACEHOLDER
RAZORPAY_KEY_SECRET=PLACEHOLDER
RAZORPAY_WEBHOOK_SECRET=PLACEHOLDER
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=PLACEHOLDER
AWS_SECRET_ACCESS_KEY=PLACEHOLDER
S3_BUCKET=sweets-app-media
ADMIN_EMAIL=admin@vyassweets.com
ADMIN_PASSWORD=<strong password>
